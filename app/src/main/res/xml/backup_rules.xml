<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 11 and older (Android 12+ uses data_extraction_rules.xml).
   Everything the app stores is backed up except Firebase Auth's saved sign-in,
   which holds the account's refresh token: restoring it would sign another
   device in to this account. After a restore the user signs in again. The app's
   own preferences (salusalo_session: welcome pages, Keep me signed in, alert
   sound; salusalo_discovery_<account>: food preferences) are still backed up.

   The file name is com.google.firebase.auth.api.Store.<base64url "[DEFAULT]">+<base64url
   Firebase app ID> (FirebaseApp.getPersistenceKey()), with the app ID from
   app/google-services.json. Update it if the Firebase Android app changes.
-->
<full-backup-content>
    <exclude
        domain="sharedpref"
        path="com.google.firebase.auth.api.Store.W0RFRkFVTFRd+MTo2NDg5NjYwNTg3OTU6YW5kcm9pZDo0MWY2NzFhMGEzYWFjMGY5MDljYjZl.xml" />
</full-backup-content>
